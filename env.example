# Sahip paneli parolası. Giriş ekranı tek adımdır; bu değer değişmeden kalır.
ADMIN_PASSWORD=

# Oturum çerezini imzalamak için uzun rastgele bir değer.
# Boşsa çerez mevcut ADMIN_PASSWORD ile imzalanır. Doluysa değiştirmeyin; değiştirmek açık oturumları düşürür.
# Yeni girişler 30 gün geçerli olur.
ADMIN_SESSION_SECRET=

# İsteğe bağlı. Tanımlıysa şu istekler Authorization: Bearer <token> ile de çalışır:
# GET /api/admin/export ve GET /api/admin/measurements/upcoming
# Boş bırakılırsa yalnızca giriş çerezi kabul edilir.
EXPORT_TOKEN=

# Neon Postgres bağlantısı. Vercel Marketplace → Neon ile projeye bağlayınca otomatik gelir.
DATABASE_URL=

# Vercel Blob. Marketplace veya Storage → Blob ile bağlayınca otomatik gelir.
BLOB_READ_WRITE_TOKEN=

# Katalog istatistikleri Neon'da tutulur. IP adresi saklanmaz, yeni bir anahtar gerekmez.

# Meta uygulaması. META_APP_ID herkese açıktır. Gizli değerleri buraya yazıp depoya koymayın.
META_APP_ID=1354864923251435
META_APP_SECRET=
# Facebook Login for Business → Embedded Signup yapılandırmasının kimliği.
META_ES_CONFIG_ID=
# Webhook doğrulama. Meta panelindeki Verify token ile aynı olmalı.
WHATSAPP_VERIFY_TOKEN=
# İş jetonunu Neon'da AES-256-GCM ile saklamak için en az 16 karakterlik rastgele değer.
WHATSAPP_TOKEN_KEY=
# Yerelde Vercel AI Gateway. Vercel'de OIDC yeterlidir; anahtarı boş bırakabilirsiniz.
AI_GATEWAY_API_KEY=
