# Sahip paneli parolası. Vercel ortam değişkeni olarak tanımlayın. Koda yazmayın.
ADMIN_PASSWORD=

# Oturum çerezini imzalamak için uzun rastgele bir değer.
ADMIN_SESSION_SECRET=

# İsteğe bağlı. Tanımlıysa GET /api/admin/export, Authorization: Bearer <token> ile de indirilebilir.
# Boş bırakılırsa yalnızca giriş çerezi kabul edilir.
EXPORT_TOKEN=

# Neon Postgres bağlantısı. Vercel Marketplace → Neon ile projeye bağlayınca otomatik gelir.
DATABASE_URL=

# Vercel Blob. Marketplace veya Storage → Blob ile bağlayınca otomatik gelir.
BLOB_READ_WRITE_TOKEN=

# İsteğe bağlı. WhatsApp Business Cloud API webhook'u bağlanınca kullanılır.
# Şimdilik paneldeki "WhatsApp mesajından ekle" akışı yeterlidir.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
